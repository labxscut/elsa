# Dedicated GPU image for LLA work.
# This does not replace the existing CPU Dockerfile; it gives the team a
# separate, explicit CUDA-based entrypoint so the build no longer depends on
# guessing which historical Dockerfile produced the current CPU image.

FROM nvidia/cuda:12.3.2-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ELSA_COMPCORE_BACKEND=auto

RUN apt-get update && apt-get install -y \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    git \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/elsa
COPY . /workspace/elsa

COPY docker/elsa-entrypoint.sh /usr/local/bin/elsa-entrypoint.sh
RUN chmod +x /usr/local/bin/elsa-entrypoint.sh

RUN pip3 install --no-cache-dir -r requirements.txt && \
    pip3 install --no-cache-dir -e . --no-deps

ENTRYPOINT ["/usr/local/bin/elsa-entrypoint.sh"]
CMD ["bash"]